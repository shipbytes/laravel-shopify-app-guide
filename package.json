{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently --kill-others --names web,queue,vite \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"vite build --watch\"",
        "build": "vite build",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@shopify/app-bridge-types": "^0.7.3",
        "@shopify/polaris-types": "^2.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "typescript": "^7.0.2",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    }
}
